@startuml

title basaltrock-private-cloud — Bedrock-shaped RAG, fully local

' ── Actors ──────────────────────────────────────────────
left to right direction

actor "User" as user
folder "DATA_FOLDER\n(any local folder)" as userfolder
user -[hidden]- userfolder

package "Docker" {

  package "basaltrock-private-cloud" #LightYellow {

    package "Object Store" #Wheat {
      database "SeaweedFS\nS3 API :8333 | filer :8888" as s3
    }

    component "ingestion-s3.py\nS3 Data Source" as s3ingest
    file "index.html\nChat UI" as ui
    file "system-prompt.txt\n{context} {history} {question}" as prompt
  }

  package basaltrock {
    package "API Service" #LightBlue {
      component "bedrock_api.py" as bedrockapi
      component "shared.py\nVector Store" as shared
    }

    package "Ingestion Service" #LightGreen {
      component "ingestion\nextract + chunk" as ingestion
    }

    database "OpenSearch\nIndex" as osindex
  }

  package "Model Runner" #LightPink {
    component "ai/gemma3:4b-q4_K_M\nChat Model" as chatmodel
    component "ai/nomic-embed-text-v2-moe\nEmbedding Model" as embedmodel

  }
}

' ── Ingest path ─────────────────────────────────────────
userfolder --> s3 : make up / make store sync\nupload (rclone)
s3ingest --> s3 : list + get objects
s3ingest --> ingestion : stage as <bucket>/<key>
ingestion --> embedmodel : create embeddings
ingestion --> osindex : write embeddings

' ── Query path ──────────────────────────────────────────
user --> ui : question
ui --> bedrockapi : 1. POST /knowledgebases/{id}/retrieve\n(question only)
ui --> bedrockapi : 2. POST /model/{id}/converse\n(context + history)
ui ..> prompt : placeholders
bedrockapi --> shared
shared --> embedmodel : query embedding
shared --> osindex : vector search (top-K)
shared --> chatmodel : generate response

' ── Download path ───────────────────────────────────────
user --> s3 : click a cited source\n(filer :8888 serves the object)


@enduml